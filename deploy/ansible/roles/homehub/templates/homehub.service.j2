[Unit]
Description=HomeHub family dashboard
After=network.target

[Service]
Type=simple
User={{ homehub_user }}
Group={{ homehub_group }}
WorkingDirectory={{ homehub_home }}
Environment=PYTHONUNBUFFERED=1
Environment=HOME={{ homehub_user_home }}
Environment=PATH={{ homehub_home }}/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart={{ homehub_home }}/.venv/bin/gunicorn wsgi:app -w 1 -k gthread --threads 4 -b {{ homehub_bind }}:{{ homehub_port }} --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
